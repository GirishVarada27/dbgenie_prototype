# Copy to .env at frontend/ if needed. Leave unset for local dev — Vite
# proxies /api to the backend (see vite.config.ts) so a relative base works.
# Set to the deployed API's public URL (e.g. https://dbgenie-api.onrender.com)
# when building the frontend for production, since it's deployed as a
# separate static site from the API web service (see render.yaml).
VITE_API_BASE_URL=
