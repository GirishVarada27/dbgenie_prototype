# Copy to .env at the repo root. Used by the backend (server/worker).
DATABASE_URL=postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/dbgenie?sslmode=require
PORT=3001

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-random-64-char-hex-string
BETTER_AUTH_URL=http://localhost:3001

# Comma-separated list of origins allowed to call the API with credentials.
# In dev, Vite proxies /api so the browser origin is the Vite origin itself.
CORS_ORIGINS=http://localhost:5176

# Used by both the API (to enqueue jobs) and the worker (to process them).
# Use rediss:// (not redis://) for providers that require TLS, e.g. Upstash.
REDIS_URL=rediss://default:password@example.upstash.io:6379

# PROTOTYPE ONLY: encrypts stored monitored-DB credentials via pgcrypto in
# the same Neon database as app data. Swap for a real secrets manager
# (Vault/AWS Secrets Manager) before handling real customer databases.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_ENCRYPTION_KEY=replace-with-a-random-64-char-hex-string

# Only needed to run backend/tests/postgres-connector.test.ts — a second
# reachable Postgres used as the "monitored" target so tests don't run
# destructive/EXPLAIN queries against the app's own DATABASE_URL.
# Defaults to DATABASE_URL if unset.
TEST_MONITORED_DATABASE_URL=

# AI Chat + Root Cause Agent (Stage 3). Uses the Gemini API, not Claude —
# see README for why this deviates from the project doc's stated stack.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Defaults to the "gemini-flash-latest" alias if unset — see ai/gemini.ts.
# GEMINI_MODEL=

# RAG embeddings for runbook_chunks (Stage 3). Gemini's embedding models
# are also an option, but this uses Voyage AI (Anthropic's recommended
# embeddings partner — chosen before the Claude->Gemini switch and left
# as-is since it works well independent of which chat model is used).
# Get a key at https://dash.voyageai.com
VOYAGE_API_KEY=

# Backup validation (Stage 4): creates/deletes temporary Neon branches via
# the Neon API. Only needed for database instances that set a Neon project
# ID when onboarded — get a key at https://console.neon.tech/app/settings/api-keys
NEON_API_KEY=

# Structured logging (Stage 4, pino). One of: fatal, error, warn, info, debug, trace.
# LOG_LEVEL=info

# Password for the dedicated, append-only audit_logs DB role (created
# automatically in db/init.ts — INSERT/SELECT only, no UPDATE/DELETE).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AUDIT_DB_ROLE_PASSWORD=replace-with-a-random-hex-string
